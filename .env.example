# ========================================
# iSAST (copy to .env and edit)
# ========================================

ISAST_WORKDIR=/tmp/isast

# ========================================
# Scanner versions (pinned; do not bump during scans)
# ========================================

OPENGREP_VERSION=v1.30.0
CODEQL_VERSION=2.27.1

# ========================================
# AI (OpenAI-compatible endpoint)
# ========================================

AI_ENABLED=true

AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5.6

AI_TIMEOUT=120
AI_MAX_RETRIES=3
AI_MAX_TOKENS=0
AI_CONCURRENCY=8
AI_TEMPERATURE=0
AI_BATCH_SIZE=20
AI_CONTEXT_LINES=30

# Wall-clock ceiling (seconds) per AI validation/dedup group. 0 disables the
# cap. Groups that exhaust it stay UNPROCESSED and get re-run on --resume.
AI_GROUP_BUDGET=600

AI_VALIDATE=true
AI_DEDUP=true
AI_REWRITE=true
AI_RISK_ANALYSIS=true